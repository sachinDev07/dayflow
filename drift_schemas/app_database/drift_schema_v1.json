          "sql": "CREATE TABLE IF NOT EXISTS \"categories\" (\"id\" TEXT NOT NULL, \"created_at\" INTEGER NOT NULL, \"updated_at\" INTEGER NOT NULL, \"deleted_at\" INTEGER NULL, \"name\" TEXT NOT NULL, \"color\" INTEGER NOT NULL, PRIMARY KEY (\"id\"), CHECK(length(id) = 36), CHECK(length(trim(name)) > 0), CHECK(color BETWEEN 0 AND 16777215), CHECK(created_at >= 0 AND updated_at >= created_at), CHECK(deleted_at IS NULL OR (deleted_at >= created_at AND deleted_at <= updated_at)));"
